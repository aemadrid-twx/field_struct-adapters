# frozen_string_literal: true

require 'bundler/gem_tasks'
require 'rspec/core/rake_task'
require 'rubocop/rake_task'
require_relative '../support/sigs'

# Several gems share this repo, so each one's release tags carry its name.
Bundler::GemHelper.tag_prefix = 'field_struct-protobuf/'

RSpec::Core::RakeTask.new(:spec)
RuboCop::RakeTask.new

AdapterSigs.define('field_struct-protobuf', libraries: %w[json date bigdecimal time], gems: %w[field_struct])

task default: %i[spec rubocop sigs:check sigs:validate]
