module FieldStruct
  # Apache Avro for FieldStruct classes: a record schema per class, and
  # instances to and from Avro datums and binary.
  # 
  #   FieldStruct::Avro.schema(Invoice)        # => {"type" => "record", "name" => "Invoice", …}
  #   bytes = FieldStruct::Avro.encode(invoice)
  #   FieldStruct::Avro.decode(Invoice, bytes) == invoice  # => true
  # 
  # Every call takes the same options:
  # 
  # * +serialization:+ the +serialize+ format whose names become Avro field
  #   names (default +:avro+; an undeclared format keeps the field names).
  # * +timestamp:+ +:micros+ (default), +:nanos+ or +:millis+, the precision
  #   of +:time+ and +:datetime+ fields. Encoding a time with more precision
  #   than that raises rather than drop it.
  # 
  # A field's +avro:+ option adjusts its own mapping: +type:+ (the whole Avro
  # type, verbatim), +timestamp:+, +precision:+ / +scale:+ for decimals,
  # +enum: false+ (a string instead of an enum) and +enum_default:+. On an
  # array or union field, all but +type:+ apply to its elements or members.
  module Avro
    TIMESTAMPS: ::Array[Symbol]
    CACHE: FieldStruct::Avro::Cache
    VERSION: String

    # The Avro record schema for +klass+, as a Hash with String keys (ready
    # for +JSON.generate+ or a schema registry).
    # 
    # _@param_ `klass`
    # 
    # _@param_ `serialization`
    # 
    # _@param_ `timestamp` — +:micros+, +:nanos+ or +:millis+
    def self.schema: (singleton(FieldStruct::Base) klass, ?serialization: Symbol, ?timestamp: Symbol) -> ::Hash[String, Object]

    # _@param_ `struct`
    # 
    # _@param_ `serialization`
    # 
    # _@param_ `timestamp`
    # 
    # _@return_ — the Avro datum for +struct+
    def self.to_datum: (FieldStruct::Base struct, ?serialization: Symbol, ?timestamp: Symbol) -> ::Hash[String, Object]

    # _@param_ `klass`
    # 
    # _@param_ `datum` — as an Avro reader returns it
    # 
    # _@param_ `serialization`
    def self.from_datum: (singleton(FieldStruct::Base) klass, ::Hash[String, Object] datum, ?serialization: Symbol) -> FieldStruct::Base

    # _@param_ `struct`
    # 
    # _@param_ `serialization`
    # 
    # _@param_ `timestamp`
    # 
    # _@return_ — the Avro binary encoding, without a container or header
    def self.encode: (FieldStruct::Base struct, ?serialization: Symbol, ?timestamp: Symbol) -> String

    # _@param_ `klass`
    # 
    # _@param_ `bytes` — binary from {.encode}
    # 
    # _@param_ `writer_schema` — the schema the bytes were written with, when it differs from +klass+'s (Avro resolves the two)
    # 
    # _@param_ `serialization`
    # 
    # _@param_ `timestamp`
    def self.decode: (
                       singleton(FieldStruct::Base) klass,
                       String bytes,
                       ?writer_schema: (::Hash[String, Object] | String)?,
                       ?serialization: Symbol,
                       ?timestamp: Symbol
                     ) -> FieldStruct::Base

    # _@param_ `klass`
    # 
    # _@param_ `timestamp`
    def self.check: (Object klass, Object timestamp) -> void

    # Opt-in class and instance methods:
    # 
    #   class Invoice < FieldStruct::Base
    #     include FieldStruct::Avro::Methods
    #   end
    #   Invoice.to_avro_schema; invoice.to_avro; Invoice.from_avro(bytes)
    module Methods
      # _@param_ `base`
      def self.included: (Class base) -> void

      # _@param_ `options` — see {FieldStruct::Avro.encode}
      def to_avro: (**::Hash[Symbol, Object] options) -> String

      # Class methods added by {Methods}.
      module ClassMethods
        # _@param_ `options` — see {FieldStruct::Avro.schema}
        def to_avro_schema: (**::Hash[Symbol, Object] options) -> ::Hash[String, Object]

        # _@param_ `bytes`
        # 
        # _@param_ `options` — see {FieldStruct::Avro.decode}
        def from_avro: (String bytes, **::Hash[Symbol, Object] options) -> FieldStruct::Base
      end
    end

    # Keeps what {FieldStruct::Avro.encode} and {FieldStruct::Avro.decode}
    # would otherwise rebuild on every call: the parsed reader schema of a
    # class, and a writer schema parsed and checked against it.
    # 
    # An entry remembers, for every struct class it covers, the class's Field
    # objects (in order), its serialization mapping and its name, and a hit
    # re-reads them, rebuilding when any changed. So a field added, replaced
    # or renamed after first use, a +serialize+ declared later, or an
    # anonymous struct assigned to a constant (which renames its record) is
    # picked up. Fields are frozen, so comparing the arrays compares each
    # field by identity.
    # 
    # @api private
    class Cache
      WRITERS_MAX: Integer

      def initialize: () -> void

      # _@param_ `klass`
      # 
      # _@param_ `serialization`
      # 
      # _@param_ `timestamp`
      def reader: (singleton(FieldStruct::Base) klass, Symbol serialization, Symbol timestamp) -> FieldStruct::Avro::Cache::Reader

      # _@param_ `writer_schema`
      # 
      # _@param_ `reader`
      # 
      # _@return_ — the
      # parsed writer schema, and the Avro field names it lacked per struct
      # class, which {Datum#load} leaves to field_struct's defaults
      def writer: ((::Hash[String, Object] | String) writer_schema, FieldStruct::Avro::Cache::Reader reader) -> [Object, ::Hash[singleton(FieldStruct::Base), ::Array[String]]]

      # What an entry is valid for, per class: its Field objects, its
      # serialization mapping and its name.
      # 
      # _@param_ `klass`
      # 
      # _@param_ `serialization`
      def self.stamp: (singleton(FieldStruct::Base) klass, Symbol serialization) -> [::Array[FieldStruct::Field], Object, String]

      # _@param_ `stamps`
      # 
      # _@param_ `serialization`
      def fresh?: (::Hash[singleton(FieldStruct::Base), ::Array[Object]] stamps, Symbol serialization) -> bool

      # A reader entry. (A plain class, not a Struct: sord writes a Struct
      # constant as +::Struct+ without its type parameter, which rbs refuses.)
      class Reader
        # _@param_ `parsed`
        # 
        # _@param_ `records`
        # 
        # _@param_ `stamps`
        def initialize: (Object parsed, ::Hash[singleton(FieldStruct::Base), ::Array[String]] records, ::Hash[singleton(FieldStruct::Base), ::Array[Object]] stamps) -> void

        # _@return_ — the +::Avro::Schema+ (the avro gem ships no
        # signatures, so the sig can't name its class)
        attr_reader parsed: Object

        # _@return_ — the Avro
        # record names each struct class was written as
        attr_reader records: ::Hash[singleton(FieldStruct::Base), ::Array[String]]

        attr_reader stamps: ::Hash[singleton(FieldStruct::Base), ::Array[Object]]
      end
    end

    # Converts instances to and from the datums the avro gem reads and
    # writes, walking the same nodes as {SchemaBuilder}.
    # 
    # @api private
    class Datum
      NANOS: ::Hash[Symbol, Integer]
      JSON_LOAD: ::Hash[Symbol, Object]

      # _@param_ `serialization`
      # 
      # _@param_ `timestamp`
      # 
      # _@param_ `absent` — the Avro field names a writer lacked, per struct class; {#load} leaves them out so field_struct applies its defaults
      def initialize: (serialization: Symbol, timestamp: Symbol, ?absent: ::Hash[singleton(FieldStruct::Base), ::Array[String]]) -> void

      # _@param_ `struct`
      def dump: (FieldStruct::Base struct) -> ::Hash[String, Object]

      # _@param_ `klass`
      # 
      # _@param_ `datum`
      def load: (singleton(FieldStruct::Base) klass, ::Hash[String, Object] datum) -> FieldStruct::Base

      # _@param_ `value`
      # 
      # _@param_ `node`
      # 
      # _@param_ `avro` — the +avro:+ options that apply
      def dump_value: (Object value, (FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node, ::Hash[Symbol, Object] avro) -> Object

      # A +:value+ member is tried last: its Ruby type is Object, so it would
      # claim a 5 that an +:integer+ member should write as a long.
      # 
      # _@param_ `value`
      # 
      # _@param_ `node`
      # 
      # _@param_ `avro`
      def dump_union: (Object value, FieldStruct::Introspection::UnionNode node, ::Hash[Symbol, Object] avro) -> Object

      # _@param_ `node`
      def value_node?: (Object node) -> bool

      # _@param_ `value`
      # 
      # _@param_ `node`
      def member_of?: (Object value, (FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node) -> bool

      # _@param_ `value`
      # 
      # _@param_ `node`
      # 
      # _@param_ `avro`
      def dump_scalar: (Object value, FieldStruct::Introspection::ScalarNode node, ::Hash[Symbol, Object] avro) -> Object

      # A +:value+ travels as the JSON text field_struct's +to_json+ writes
      # for it: ISO 8601 times, plain decimals. This follows field_struct's
      # private +Base#json_value+ for a field with no +format:+.
      # 
      # _@param_ `value`
      def json_value: (Object value) -> Object

      # _@param_ `node`
      # 
      # _@param_ `avro`
      # 
      # _@return_ — whether the decimal travels as an Avro decimal
      def decimal?: (FieldStruct::Introspection::ScalarNode node, ::Hash[Symbol, Object] avro) -> bool

      # _@param_ `time`
      # 
      # _@param_ `avro`
      def exact_time: (::Time time, ::Hash[Symbol, Object] avro) -> ::Time

      # _@param_ `property`
      # 
      # _@return_ — the field's +avro:+ option, whatever
      # its node (a struct or union node carries no options of its own)
      def field_avro: (FieldStruct::Introspection::Property property) -> ::Hash[Symbol, Object]

      # An array's elements and a union's members take the field's +avro:+
      # options, under any of their own, except +:type+, which replaces only
      # the field it was given on.
      # 
      # _@param_ `avro` — the enclosing node's options
      # 
      # _@param_ `node`
      def nested: (::Hash[Symbol, Object] avro, Object node) -> ::Hash[Symbol, Object]

      # _@param_ `node`
      def avro_options: (Object node) -> ::Hash[Symbol, Object]

      # A field whose +avro: {type:}+ replaces its mapping: the user chose the
      # Avro type, so the value travels as field_struct holds it.
      # 
      # _@param_ `node`
      # 
      # _@param_ `avro`
      def override?: (Object node, ::Hash[Symbol, Object] avro) -> bool

      # _@param_ `value`
      # 
      # _@return_ — +value+, with symbols as strings (Avro has none)
      def raw: (Object value) -> Object

      # The Avro type is the user's, but what {#raw} dumped comes back the
      # same way: structs through their own mappings, a time in its zone:.
      # 
      # _@param_ `value`
      # 
      # _@param_ `node`
      def load_override: (Object value, (FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node) -> Object

      # _@param_ `value`
      # 
      # _@param_ `node`
      # 
      # _@param_ `avro` — the +avro:+ options that apply
      def load_value: (Object value, (FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node, ::Hash[Symbol, Object] avro) -> Object

      # A record datum carries no branch name, so it loads as the struct
      # member whose keys it has. A string is a +:value+ member's JSON
      # when the union has one: only one member can be Avro +string+ (the
      # schema refuses two). Anything else goes to the union as is.
      # 
      # _@param_ `value`
      # 
      # _@param_ `node`
      def load_union: (Object value, FieldStruct::Introspection::UnionNode node) -> Object

      # _@param_ `value`
      # 
      # _@param_ `node`
      def load_scalar: (Object value, FieldStruct::Introspection::ScalarNode node) -> Object

      # Avro times come back in UTC; a field with +zone:+ gets them in its
      # zone again, as it would from a string.
      # 
      # _@param_ `time`
      # 
      # _@param_ `zone`
      def rezone: (::Time time, String? zone) -> ::Time
    end

    # Checks a writer and reader schema pair before {Avro.decode} resolves
    # them. The avro gem matches a field by its base type only, so a decimal
    # written with scale 2 and read with scale 3, or a timestamp written in
    # micros and read in nanos, decodes without an error into the wrong
    # value. This walks both schemas the way resolution pairs them and raises
    # instead. Only the logical types the avro gem decodes count (decimal,
    # date, the timestamps): a +uuid+ is a plain string on the wire.
    # 
    # @api private
    class Resolution
      PROMOTIONS: ::Hash[Symbol, ::Array[Symbol]]

      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@return_ — for each reader record's full
      # name, the fields the writer lacked, which the avro gem fills from
      # the reader's defaults
      def self.check: (Object writer, Object reader) -> ::Hash[String, ::Array[String]]

      def initialize: () -> void

      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@param_ `path`
      # 
      # _@param_ `seen` — writer and reader names of the records already walked (recursive structs)
      def compare: (
                     Object writer,
                     Object reader,
                     String path,
                     ::Array[::Array[String]] seen
                   ) -> ::Array[String]

      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@param_ `path`
      # 
      # _@param_ `seen`
      def union: (
                   Object writer,
                   Object reader,
                   String path,
                   ::Array[::Array[String]] seen
                 ) -> ::Array[String]

      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@param_ `path`
      # 
      # _@param_ `seen`
      def record: (
                    Object writer,
                    Object reader,
                    String path,
                    ::Array[::Array[String]] seen
                  ) -> ::Array[String]

      # Avro promotes a writer's int to long, float or double, a long to
      # float or double, and string and bytes into each other. When either
      # side is a decoded logical type, the promoted value is wrong: a date's
      # day count read as a timestamp's micros, a decimal's bytes as text.
      # 
      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@param_ `path`
      def promoted: (Object writer, Object reader, String path) -> ::Array[String]

      # _@param_ `schema` — an +::Avro::Schema+
      # 
      # _@return_ — its logical type, when the avro gem decodes it
      def decoded: (Object schema) -> String?

      # _@param_ `writer` — an +::Avro::Schema+
      # 
      # _@param_ `reader` — an +::Avro::Schema+
      # 
      # _@param_ `path`
      def logical: (Object writer, Object reader, String path) -> ::Array[String]

      # Precision isn't part of it: the avro gem never reads it when decoding,
      # so widening a decimal's precision is a safe change.
      # 
      # _@param_ `schema` — an +::Avro::Schema+
      def describe: (Object schema) -> String

      attr_reader absent: ::Hash[String, ::Array[String]]
    end

    # Builds one root class's record schema. A named nested struct becomes a
    # record named after its class (+Billing::Invoice+ is +Invoice+ in
    # namespace +Billing+), defined at first use and referenced by full name
    # after that, so recursive structs work. An anonymous one is named
    # +<Record>_<field>+.
    # 
    # @api private
    class SchemaBuilder
      NAME: Regexp
      DEFAULT_PRECISION: Integer
      UNION_SLOT: ::Hash[String, String]

      # _@param_ `root`
      # 
      # _@param_ `serialization`
      # 
      # _@param_ `timestamp`
      def initialize: (singleton(FieldStruct::Base) root, serialization: Symbol, timestamp: Symbol) -> void

      def schema: () -> ::Hash[String, Object]

      # A class with no module of its own takes the namespace of the record
      # it is first defined in, as Avro would give it, and is written with
      # that namespace and referred to by that full name everywhere after.
      # 
      # _@param_ `klass`
      # 
      # _@param_ `anonymous_name` — the name for an anonymous struct
      # 
      # _@param_ `namespace` — the enclosing record's namespace
      # 
      # _@return_ — the record, or its full name
      # when it is already defined
      def record: (singleton(FieldStruct::Base) klass, String? anonymous_name, String? namespace) -> (::Hash[String, Object] | String)

      # _@param_ `klass` — a class already defined in this schema
      # 
      # _@param_ `namespace` — the namespace the reference sits in
      # 
      # _@return_ — its full name
      def reference: (singleton(FieldStruct::Base) klass, String? namespace) -> String

      # _@param_ `class_name` — +"Billing::Invoice"+
      # 
      # _@return_ — +["Invoice", "Billing"]+ (+nil+
      # namespace for a top-level class)
      def split_name: (String class_name) -> ([String, String] | [String, NilClass])

      # _@param_ `property`
      # 
      # _@param_ `record_name`
      # 
      # _@param_ `namespace`
      def field_schema: (FieldStruct::Introspection::Property property, String record_name, String? namespace) -> ::Hash[String, Object]

      # _@param_ `property`
      # 
      # _@return_ — the field's +avro:+ option, whatever
      # its node (a struct or union node carries no options of its own)
      def field_avro: (FieldStruct::Introspection::Property property) -> ::Hash[Symbol, Object]

      # An array's elements and a union's members take the field's +avro:+
      # options, under any of their own, except +:type+, which replaces only
      # the field it was given on.
      # 
      # _@param_ `avro` — the enclosing node's options
      # 
      # _@param_ `node`
      def nested: (::Hash[Symbol, Object] avro, Object node) -> ::Hash[Symbol, Object]

      # _@param_ `node`
      # 
      # _@return_ — the node's +avro:+ option
      def avro_options: ((FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node) -> ::Hash[Symbol, Object]

      # _@param_ `node`
      # 
      # _@param_ `avro` — the node's +avro:+ option
      # 
      # _@param_ `name` — the name for an anonymous record or an enum
      # 
      # _@param_ `namespace`
      def type_for: (
                      (FieldStruct::Introspection::ScalarNode | FieldStruct::Introspection::ArrayNode | FieldStruct::Introspection::UnionNode | FieldStruct::Introspection::StructNode) node,
                      ::Hash[Symbol, Object] avro,
                      String name,
                      String? namespace
                    ) -> (String | ::Hash[String, Object] | ::Array[Object])

      # _@param_ `node`
      # 
      # _@param_ `avro`
      # 
      # _@param_ `name`
      # 
      # _@param_ `namespace`
      def array_type: (
                        FieldStruct::Introspection::ArrayNode node,
                        ::Hash[Symbol, Object] avro,
                        String name,
                        String? namespace
                      ) -> ::Hash[String, Object]

      # _@param_ `node`
      # 
      # _@param_ `avro`
      # 
      # _@param_ `name`
      # 
      # _@param_ `namespace`
      def union_type: (
                        FieldStruct::Introspection::UnionNode node,
                        ::Hash[Symbol, Object] avro,
                        String name,
                        String? namespace
                      ) -> ::Array[Object]

      # Avro writes a union datum as the first branch it fits, and a record
      # fits any Hash holding its required keys (extra keys are ignored), so
      # an earlier struct member whose required keys a later one also has
      # would swallow it: the later struct is written as the earlier one and
      # loses its other fields. Two members with the same keys also can't be
      # told apart when read back.
      # 
      # _@param_ `node`
      # 
      # _@param_ `name`
      def check_struct_members: (FieldStruct::Introspection::UnionNode node, String name) -> void

      # A required field with an +avro: {type:}+ override may have been made
      # nullable, so it doesn't count as required here.
      # 
      # _@param_ `klass`
      # 
      # _@param_ `required_only`
      # 
      # _@return_ — the Avro field names
      def struct_keys: (singleton(FieldStruct::Base) klass, ?required_only: bool) -> ::Array[String]

      # _@param_ `type`
      # 
      # _@return_ — what Avro allows once per union
      def union_slot: ((String | ::Hash[String, Object]) _type) -> String

      # _@param_ `type`
      # 
      # _@param_ `options`
      # 
      # _@param_ `avro`
      # 
      # _@param_ `name`
      # 
      # _@param_ `namespace`
      def scalar_type: (
                         FieldStruct::Types::Base _type,
                         ::Hash[Symbol, Object] options,
                         ::Hash[Symbol, Object] avro,
                         String name,
                         String? namespace
                       ) -> (String | ::Hash[String, Object])

      # _@param_ `avro`
      def timestamp: (::Hash[Symbol, Object] avro) -> Symbol

      # A +round:+ decimal is an Avro decimal with that scale. Without one
      # there is no scale to declare, so the digits travel as a string.
      # 
      # _@param_ `type`
      # 
      # _@param_ `options`
      # 
      # _@param_ `avro`
      # 
      # _@param_ `name`
      def decimal_type: (
                          FieldStruct::Types::BigDecimal _type,
                          ::Hash[Symbol, Object] options,
                          ::Hash[Symbol, Object] avro,
                          String name
                        ) -> (String | ::Hash[String, Object])

      # _@param_ `options`
      # 
      # _@param_ `avro`
      # 
      # _@param_ `name`
      # 
      # _@param_ `namespace`
      # 
      # _@return_ — +nil+ when the symbols can't be
      # Avro enum symbols, or +avro: {enum: false}+
      def enum_type: (
                       ::Hash[Symbol, Object] options,
                       ::Hash[Symbol, Object] avro,
                       String name,
                       String? namespace
                     ) -> ::Hash[String, Object]?

      # A literal default of the field's own Avro type; anything else (a
      # callable, a date) is left out.
      # 
      # _@param_ `field`
      # 
      # _@param_ `type`
      def default_for: (FieldStruct::Field field, (String | ::Hash[String, Object] | ::Array[Object]) _type) -> Object?

      # _@param_ `field`
      # 
      # _@param_ `value`
      def string_default: (FieldStruct::Field field, Object value) -> String?

      # _@param_ `type`
      # 
      # _@return_ — +type+ also accepting +null+, first
      def nullable: ((String | ::Hash[String, Object] | ::Array[Object]) _type) -> ::Array[Object]

      # _@param_ `name`
      # 
      # _@param_ `what`
      def check_name: (String name, String what) -> void

      # Each struct class's {Cache.stamp}, taken before the class was read,
      # so a class changed while {#schema} ran makes the entry stale rather
      # than a stale entry look fresh.
      attr_reader stamps: ::Hash[singleton(FieldStruct::Base), ::Array[Object]]

      # The Avro full names each struct class was written as, filled in by
      # {#schema}. An anonymous struct used in two fields has two.
      attr_reader records: ::Hash[singleton(FieldStruct::Base), ::Array[String]]
    end
  end
end